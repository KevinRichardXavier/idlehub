# Lista de permissão: ignora TUDO e libera só o que é do IdleHub.
# Para versionar um arquivo/pasta novo, adicione uma linha "!caminho" abaixo.
/*

!/.gitignore
!/.github/
!/.nvmrc
!/docs/
!/README.md
!/package.json
!/package-lock.json
!/scripts/
!/src/
!/test/

# Mesmo dentro das pastas liberadas, nunca versionar:
.env
.env.*
*.log
*.local.json
config.json
events.json
# Gerado por scripts/montar-preload.js (roda sozinho antes de start, test, fumaca e dist).
/src/gerado/
