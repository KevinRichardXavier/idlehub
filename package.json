{
  "name": "idlehub",
  "productName": "IdleHub",
  "version": "0.3.0",
  "description": "Painéis multi-conta para jogos idle de navegador, com alertas e resumos no Discord.",
  "homepage": "https://github.com/KevinRichardXavier/idlehub",
  "main": "src/main.js",
  "private": true,
  "author": "IdleHub",
  "scripts": {
    "prestart": "node scripts/montar-preload.js",
    "start": "electron .",
    "pretest": "node scripts/montar-preload.js",
    "test": "node --test \"test/**/*.test.js\"",
    "prefumaca": "node scripts/montar-preload.js",
    "fumaca": "electron . --teste-fumaca",
    "predist": "node scripts/montar-preload.js",
    "dist": "electron-builder --win --publish never",
    "predist:linux": "node scripts/montar-preload.js",
    "dist:linux": "electron-builder --linux deb --publish never",
    "prerelease": "node scripts/montar-preload.js",
    "release": "electron-builder --win --publish always",
    "montar": "node scripts/montar-preload.js"
  },
  "build": {
    "appId": "com.idlehub.app",
    "productName": "IdleHub",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "IdleHub-Setup-${version}.${ext}"
    },
    "linux": {
      "target": "deb",
      "category": "Game",
      "maintainer": "IdleHub",
      "synopsis": "Painéis multi-conta para jogos idle de navegador"
    },
    "publish": {
      "provider": "github",
      "owner": "KevinRichardXavier",
      "repo": "idlehub",
      "releaseType": "release"
    }
  },
  "devDependencies": {
    "electron": "^45.3.1",
    "electron-builder": "^26.18.0"
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  }
}
